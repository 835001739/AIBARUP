# ===== AIBAR 本地配置示例 =====
# 复制为 .env 后按需修改。所有配置都是可选的，缺失时使用默认值。

# --- ComfyUI 联动（M1）---
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
# ComfyUI 安装根目录（用于定位 workflows / output / models 目录）
COMFYUI_DIR=
# 启动 ComfyUI 使用的 Python 解释器（conda 环境）。留空则自动探测
COMFYUI_PYTHON=
# 应用启动时是否自动探测并尝试拉起 ComfyUI
COMFYUI_AUTOSTART=true

# --- 同步引擎（M4）---
SYNC_INTERVAL=10
SYNC_AUTO=true
SEED_LIMIT=60

# --- 站点 ---
AIBAR_HOST=127.0.0.1
AIBAR_PORT=8099

# --- 图片反推上传（M9）---
REVERSE_UPLOAD_MAX_MB=20
REVERSE_UPLOAD_TTL_HOURS=24

# --- 本地视觉 Provider（M10，可选）---
# 指向任意 OpenAI-compatible 的 /v1 服务端点
LOCAL_VISION_ENABLED=false
LOCAL_VISION_ENDPOINT=
LOCAL_VISION_MODEL=
LOCAL_VISION_TIMEOUT=120

# --- 外部视觉 Provider（M9，可选，默认关闭）---
OPENAI_VISION_ENABLED=false
OPENAI_VISION_ENDPOINT=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini
# API Key 只从环境变量读取，不写数据库、不返回前端、不进入日志
OPENAI_VISION_API_KEY=
OPENAI_VISION_TIMEOUT=120

# --- 可选 AI 语义扩写 / 本地 GPT（M6.4，默认关闭）---
# 任何 OpenAI-compatible 服务都能接：Ollama / LM Studio / llama.cpp / vLLM。
# 端点写根地址或 /v1 都可以，AIBAR 会自动归一化。
#   Ollama     : AI_PROVIDER_ENDPOINT=http://127.0.0.1:11434/v1
#   LM Studio  : AI_PROVIDER_ENDPOINT=http://127.0.0.1:1234/v1
#   llama.cpp  : AI_PROVIDER_ENDPOINT=http://127.0.0.1:8080/v1
AI_PROVIDER_ENABLED=false
AI_PROVIDER_ENDPOINT=
# 留空且 AI_PROVIDER_AUTO_MODEL=true 时，自动使用 /v1/models 的第一个模型
AI_PROVIDER_MODEL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_TIMEOUT=120
AI_PROVIDER_AUTO_MODEL=true
AI_PROVIDER_MAX_TOKENS=1024

# --- AI 视频工作台资产出图 ---
AI_VIDEO_GENERATE_TIMEOUT=300
AI_VIDEO_ASSET_MAX_MB=32
